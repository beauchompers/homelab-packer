#cloud-config
autoinstall:
  apt:
    geoip: true
    preserve_sources_list: false
    primary:
    - arches: [amd64, i386]
      uri: http://ca.archive.ubuntu.com/ubuntu
    - arches: [default]
      uri: http://ports.ubuntu.com/ubuntu-ports 
  # identity: 
  #   hostname: packer-ubuntu
  #   password: "$6$exDY1mhS4KUYCE/2$zmn9ToZwTKLhCw.b4/b.ZRTIZM30JZ4QrOQ2aOXJ8yk96xpcCof0kxKwuX1kqLG/ygbJ1f8wxED22bTL4F46P0" #ubuntu
  #   username: ubuntu
  #   realname: ubuntu
  keyboard: {layout: us, toggle: null, variant: ''}
  locale: en_US
  network:
    ethernets:
      # q35 puts the nic behind a pci bridge, so it isn't ens18 (usually enp6s18)
      nic0:
        match: {name: "en*"}
        dhcp4: true
    version: 2
  ssh:
    allow-pw: true
    install-server: true
  package_update: true
  package_upgrade: true
  packages:
    - qemu-guest-agent
    # used by the first-boot resize script (files/10-resize-root.sh)
    - gdisk
    - parted
    - lvm2
    # the uefi installer normally adds these, listed so secure boot never depends on that
    - shim-signed
    - grub-efi-amd64-signed
  storage:
    layout:
      name: lvm
      # ubuntu-lv fills sda3, instead of the installer's default of leaving half the vg free
      sizing-policy: all
  timezone: "US/Mountain"
  users:
  - default
  - name: ubuntu
    plain_text_passwd: "ubuntu"
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    home: /home/ubuntu
    shell: /bin/bash
    lock_passwd: false
    gecos: ubuntu
    groups: [adm, audio, cdrom, dialout, floppy, video, plugdev, dip, netdev]
    updates: security
    version: 1